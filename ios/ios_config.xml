     FILE: ios/Runner/Info.plist
     ADD these keys inside the existing <dict> block.
     Do NOT replace the entire file — merge these keys in.
     ══════════════════════════════════════════════════════════════ -->

	<!-- Camera & Photos -->
	<key>NSCameraUsageDescription</key>
	<string>Vaastu PMC uses the camera to capture photos for DPR reports, snag documentation, visit forms and receipts.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Vaastu PMC accesses your photo library to attach images to construction reports and documentation.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Vaastu PMC saves captured photos to your library.</string>

	<!-- GPS -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Vaastu PMC uses your location to record GPS check-in and check-out at project sites.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Vaastu PMC uses your location for site attendance verification.</string>

	<!-- Biometric -->
	<key>NSFaceIDUsageDescription</key>
	<string>Vaastu PMC uses Face ID to quickly and securely unlock the app.</string>

	<!-- Background modes: push notifications + background fetch -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- Deep link scheme -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vaastupmc</string>
			</array>
		</dict>
	</array>

	<!-- Associated domain for HTTPS deep links -->
	<!-- Also add "applinks:app.vaastu-pmc.com" in Xcode Signing & Capabilities -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.vaastu-pmc.com</string>
	</array>

	<!-- Allow WebView local storage & IndexedDB -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>app.vaastu-pmc.com</string>
	</array>

	<!-- Minimum iOS version (set to 14 for webview_flutter 4.x) -->
	<key>MinimumOSVersion</key>
	<string>14.0</string>


